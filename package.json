{
  "name": "@mku1tra/que-pasa",
  "version": "0.0.0-development",
  "description": "An agent harness on pi-durable: define agents and tools with define/, and run them durably and traced with loop/.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matta-kelly/que-pasa.git"
  },
  "type": "module",
  "packageManager": "npm@11.21.3",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    "./define": {
      "types": "./dist/define/index.d.ts",
      "default": "./dist/define/index.js"
    },
    "./files": {
      "types": "./dist/files/index.d.ts",
      "default": "./dist/files/index.js"
    },
    "./loop": {
      "types": "./dist/loop/index.d.ts",
      "default": "./dist/loop/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "default": "./dist/middleware/index.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox/index.d.ts",
      "default": "./dist/sandbox/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.6.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "ai": "7.0.177",
    "aws4fetch": "1.0.20",
    "hono": "4.13.19",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mku1tra/basis": "^0.30.0",
    "@mku1tra/it": "^0.9.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.14.0",
    "jiti": "2.7.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "zod": "4.6.7"
  }
}
