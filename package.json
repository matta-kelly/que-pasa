{
  "name": "@mku1tra/que-pasa",
  "version": "0.2.1",
  "description": "An agent harness on pi-durable: define agents and tools with define/, and run them durably and traced with loop/.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matta-kelly/que-pasa.git"
  },
  "type": "module",
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    "./define": {
      "types": "./dist/define/index.d.ts",
      "default": "./dist/define/index.js"
    },
    "./loop": {
      "types": "./dist/loop/index.d.ts",
      "default": "./dist/loop/index.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox/index.d.ts",
      "default": "./dist/sandbox/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0"
  },
  "peerDependencies": {
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mku1tra/basis": "^0.30.0",
    "@mku1tra/it": "^0.9.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "zod": "4.6.7"
  }
}
