{
  "name": "que-pasa",
  "description": "que-v2's harness: it knows no company. A workspace's agents are written against define/, and loop/ runs them. Installed from its folder, built: dist/.",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    "./define": {
      "types": "./dist/define/index.d.ts",
      "default": "./dist/define/index.js"
    },
    "./loop": {
      "types": "./dist/loop/index.d.ts",
      "default": "./dist/loop/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0"
  },
  "peerDependencies": {
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mku1tra/basis": "^0.30.0",
    "@mku1tra/it": "^0.9.0",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "zod": "4.6.7"
  }
}
